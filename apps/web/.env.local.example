# Copiar este archivo como .env.local y rellenar con tus valores de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Service role — solo backend, NUNCA exponer al cliente
# Supabase > Project Settings > API Keys > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Stripe (modo sandbox - no cobra nada hasta que actives live mode)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Identificador del negocio activo (fallback white-label cuando no hay subdominio)
NEXT_PUBLIC_STORE_SLUG=ropa-demo
